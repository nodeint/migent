{
  "name": "migent-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && node scripts/copy-templates.mjs",
    "generate": "pnpm build && node scripts/generate.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "node scripts/wrappers/run-integration.mjs",
    "migent": "node packages/cli/dist/index.js",
    "setup:git": "node scripts/setup-git.mjs",
    "lint": "node scripts/wrappers/run-eslint.mjs --max-warnings 0",
    "lint:fix": "node scripts/wrappers/run-eslint.mjs --max-warnings 0 --fix",
    "lint:md": "node scripts/docs/lint-md.mjs",
    "lint:md:fix": "node scripts/docs/lint-md.mjs --fix",
    "lint:md:links": "node scripts/docs/lint-md-links.mjs",
    "knip": "knip --no-progress",
    "jscpd": "jscpd"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nodeint/migent": "workspace:*",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "^10.13.0",
    "eslint-plugin-only-warn": "^1.2.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^77.0.0",
    "globals": "^17.13.0",
    "jscpd": "5.4.3",
    "knip": "^6.45.1",
    "markdownlint-cli2": "^0.24.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.3"
  }
}