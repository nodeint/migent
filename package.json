{
  "name": "migent-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && node scripts/copy-templates.mjs",
    "generate": "pnpm build && node scripts/generate.mjs",
    "test": "vitest run",
    "migent": "node packages/cli/dist/index.js",
    "setup:git": "node scripts/setup-git.mjs",
    "lint": "node scripts/wrappers/run-eslint.mjs",
    "lint:strict": "node scripts/wrappers/run-eslint.mjs --max-warnings 0",
    "lint:fix": "node scripts/wrappers/run-eslint.mjs --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@nodeint/migent": "workspace:*",
    "vitest": "^5.0.3",
    "eslint": "^10.13.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^77.0.0",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}