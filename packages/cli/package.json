{
  "name": "@nodeint/migent",
  "version": "0.1.1",
  "description": "Compose AI coding agents into repeatable engineering workflows.",
  "keywords": [
    "ai",
    "agents",
    "workflow",
    "cli",
    "claude",
    "codex",
    "grok",
    "migent"
  ],
  "license": "MIT",
  "homepage": "https://github.com/nodeint/migent/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/nodeint/migent/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodeint/migent.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "migent": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b && rm -rf dist/templates && cp -R src/templates dist/templates",
    "prepack": "pnpm -w run build && cp ../../LICENSE . && cp ../../README.md ."
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@nodeint/migent-adapters": "workspace:*",
    "@nodeint/migent-kernel": "workspace:*",
    "@nodeint/migent-registry": "workspace:*",
    "commander": "^14.0.2",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4"
  }
}
