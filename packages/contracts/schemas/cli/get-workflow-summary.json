{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nodeint/migent/main/packages/contracts/schemas/cli/get-workflow-summary.json",
  "type": "object",
  "required": [
    "kind",
    "name",
    "file",
    "stages",
    "roles",
    "problems"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "const": "workflow"
    },
    "name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "file": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "title": "get workflows -o json item"
}
