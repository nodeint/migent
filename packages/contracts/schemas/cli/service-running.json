{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nodeint/migent/main/packages/contracts/schemas/cli/service-running.json",
  "type": "object",
  "required": [
    "state",
    "host",
    "port",
    "pid"
  ],
  "properties": {
    "state": {
      "type": "string",
      "const": "running"
    },
    "host": {
      "type": "string"
    },
    "port": {
      "type": "number"
    },
    "pid": {
      "type": "number"
    }
  },
  "title": "service status --json (running)"
}
