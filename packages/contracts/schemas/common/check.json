{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nodeint/migent/main/packages/contracts/schemas/common/check.json",
  "type": "object",
  "required": [
    "name",
    "ok",
    "items",
    "problems",
    "warnings"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "ok": {
      "type": "boolean"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "title": "Doctor check"
}
