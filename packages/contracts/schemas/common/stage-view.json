{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nodeint/migent/main/packages/contracts/schemas/common/stage-view.json",
  "type": "object",
  "required": [
    "id",
    "role",
    "description",
    "depends_on",
    "agent",
    "options",
    "artifact",
    "artifacts",
    "decision_artifacts",
    "decisions",
    "max_revisions",
    "resume_from",
    "verify",
    "max_verify",
    "verify_timeout",
    "run_when",
    "ask",
    "target",
    "problems"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "role": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "agent": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "required": [
                "inline"
              ],
              "properties": {
                "inline": {
                  "type": "boolean",
                  "const": true
                }
              }
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "options": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "string"
        }
      }
    },
    "artifact": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "file",
          "description",
          "required",
          "scope"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "required": {
            "type": "boolean"
          },
          "scope": {
            "anyOf": [
              {
                "type": "string",
                "const": "published"
              },
              {
                "type": "string",
                "const": "local"
              }
            ]
          }
        }
      }
    },
    "decision_artifacts": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "file",
              "description",
              "required",
              "scope"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "description": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "required": {
                "type": "boolean"
              },
              "scope": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "published"
                  },
                  {
                    "type": "string",
                    "const": "local"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "value",
          "when",
          "navigate"
        ],
        "properties": {
          "value": {
            "type": "string"
          },
          "when": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "navigate": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "max_revisions": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "resume_from": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "on_expired": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "verify": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "max_verify": {
      "type": "number"
    },
    "verify_timeout": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_when": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "changed_paths"
          ],
          "properties": {
            "changed_paths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "ask": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "target": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "client",
            "model",
            "options"
          ],
          "properties": {
            "client": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "options": {
              "type": "object",
              "patternProperties": {
                "^.*$": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "title": "Workflow stage view"
}
