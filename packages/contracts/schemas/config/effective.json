{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nodeint/migent/main/packages/contracts/schemas/config/effective.json",
  "type": "object",
  "required": [
    "roles"
  ],
  "properties": {
    "schema_version": {
      "type": "number",
      "description": "Document version. The local file's value is ignored."
    },
    "agents": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "anyOf": [
            {
              "$ref": "https://raw.githubusercontent.com/nodeint/migent/main/packages/contracts/schemas/config/resolved-agent.json"
            },
            {
              "$ref": "https://raw.githubusercontent.com/nodeint/migent/main/packages/contracts/schemas/config/agent-placeholder.json"
            }
          ]
        }
      }
    },
    "roles": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "$ref": "https://raw.githubusercontent.com/nodeint/migent/main/packages/contracts/schemas/config/role.json"
        }
      }
    },
    "plugins": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "object",
          "patternProperties": {
            "^.*$": {}
          },
          "description": "A mapping."
        }
      },
      "description": "Plugin entries by plugin id. Every entry takes `enabled` (default `true`), `on_error` and `timeout_sec`; a plugin that calls an agent also takes `agent` (a named agent or an inline one) and `description`. Other fields belong to the plugin. Sessions freeze every entry except an advisory plugin; a local layer may set `enabled: false`. Example: `plugins: { my_plugin: { enabled: true } }`."
    }
  },
  "title": "Effective config",
  "description": "The config after layers merge."
}
