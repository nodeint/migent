{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nodeint/migent/main/packages/contracts/schemas/config/effective.json",
  "type": "object",
  "required": [
    "roles"
  ],
  "properties": {
    "schema_version": {
      "type": "number",
      "description": "Document version. The local file's value is ignored."
    },
    "agents": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "anyOf": [
            {
              "$ref": "https://raw.githubusercontent.com/nodeint/migent/main/packages/contracts/schemas/config/resolved-agent.json"
            },
            {
              "$ref": "https://raw.githubusercontent.com/nodeint/migent/main/packages/contracts/schemas/config/agent-placeholder.json"
            }
          ]
        }
      }
    },
    "roles": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "$ref": "https://raw.githubusercontent.com/nodeint/migent/main/packages/contracts/schemas/config/role.json"
        }
      }
    }
  },
  "title": "Effective config",
  "description": "The config after layers merge."
}
