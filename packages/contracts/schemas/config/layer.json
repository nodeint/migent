{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nodeint/migent/main/packages/contracts/schemas/config/layer.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "description": "Document version. The local file's value is ignored."
    },
    "agents": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "$ref": "https://raw.githubusercontent.com/nodeint/migent/main/packages/contracts/schemas/config/named-agent-fragment.json"
        }
      }
    },
    "roles": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "$ref": "https://raw.githubusercontent.com/nodeint/migent/main/packages/contracts/schemas/config/role.json"
        }
      }
    }
  },
  "title": "Config file",
  "description": "`config.yaml` or `config.local.yaml`."
}
