{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nodeint/migent/main/packages/contracts/schemas/config/named-agent-fragment.json",
  "type": "object",
  "properties": {
    "model": {
      "type": "string",
      "pattern": "\\S",
      "description": "A string with a non-blank value."
    },
    "effort": {
      "type": "string",
      "pattern": "\\S",
      "description": "A string with a non-blank value."
    },
    "client": {
      "anyOf": [
        {
          "$ref": "https://raw.githubusercontent.com/nodeint/migent/main/packages/contracts/schemas/config/client.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "prompt_cache_ttl": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "pattern": "\\S",
          "description": "The name of a `plugins.prompt_cache_ttl.policies` entry."
        }
      },
      "additionalProperties": false,
      "description": "Selects the prompt cache policy of the agent."
    }
  },
  "title": "Named agent (layer)",
  "description": "A partial named agent in one config file."
}
