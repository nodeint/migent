{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nodeint/migent/main/packages/contracts/schemas/config/resume-policy.json",
  "type": "object",
  "required": [
    "cache_ttl"
  ],
  "properties": {
    "match": {
      "$ref": "https://raw.githubusercontent.com/nodeint/migent/main/packages/contracts/schemas/config/resume-policy-match.json"
    },
    "cache_ttl": {
      "type": "string",
      "pattern": "^\\d+(s|m|h)$",
      "description": "How long the prompt cache lives, such as `5m` or `1h`."
    },
    "margin": {
      "type": "string",
      "pattern": "^\\d+(s|m|h)$",
      "description": "Safety margin subtracted from `cache_ttl`."
    },
    "min_context_tokens": {
      "type": "integer",
      "minimum": 0,
      "description": "Below this context size an expired cache is not worth guarding."
    },
    "on_expired": {
      "$ref": "https://raw.githubusercontent.com/nodeint/migent/main/packages/contracts/schemas/config/resume-on-expired.json"
    }
  },
  "title": "Resume policy",
  "description": "A guard for resuming a conversation after the prompt cache may have expired.",
  "additionalProperties": false
}
