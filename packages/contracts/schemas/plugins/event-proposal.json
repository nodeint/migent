{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nodeint/migent/main/packages/contracts/schemas/plugins/event-proposal.json",
  "anyOf": [
    {
      "type": "object",
      "required": [
        "kind",
        "name",
        "content"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "artifact"
        },
        "name": {
          "type": "string"
        },
        "content": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "kind",
        "text"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "note"
        },
        "text": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "none"
        }
      }
    }
  ],
  "title": "Plugin event proposal",
  "description": "A closed union. The core decides and records every effect. At most one `artifact` per invocation."
}
