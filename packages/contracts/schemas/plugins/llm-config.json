{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nodeint/migent/main/packages/contracts/schemas/plugins/llm-config.json",
  "type": "object",
  "required": [
    "agent"
  ],
  "properties": {
    "enabled": {
      "type": "boolean",
      "description": "Default `true`."
    },
    "agent": {
      "$ref": "https://raw.githubusercontent.com/nodeint/migent/main/packages/contracts/schemas/config/role-agent.json"
    },
    "responsibilities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S",
        "description": "A string with a non-blank value."
      }
    },
    "description": {
      "type": "string",
      "pattern": "\\S",
      "description": "A string with a non-blank value."
    },
    "on_error": {
      "$ref": "https://raw.githubusercontent.com/nodeint/migent/main/packages/contracts/schemas/plugins/on-error.json"
    },
    "timeout_sec": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  },
  "title": "LLM plugin config",
  "description": "Shared fields of a plugin that declares `invokeAgent`."
}
