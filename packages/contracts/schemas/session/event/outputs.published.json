{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nodeint/migent/main/packages/contracts/schemas/session/event/outputs.published.json",
  "type": "object",
  "required": [
    "event",
    "timestamp",
    "data"
  ],
  "properties": {
    "v": {
      "anyOf": [
        {
          "type": "number",
          "const": 2
        },
        {
          "type": "number",
          "const": 1
        }
      ]
    },
    "seq": {
      "type": "number"
    },
    "event": {
      "type": "string",
      "const": "outputs.published"
    },
    "timestamp": {
      "type": "string"
    },
    "execution_id": {
      "type": "string"
    },
    "stage_id": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "outputs"
      ],
      "properties": {
        "outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "patternProperties": {
              "^.*$": {}
            }
          }
        }
      }
    }
  },
  "title": "Event `outputs.published`"
}
