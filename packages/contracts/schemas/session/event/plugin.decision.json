{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nodeint/migent/main/packages/contracts/schemas/session/event/plugin.decision.json",
  "type": "object",
  "required": [
    "event",
    "timestamp",
    "data"
  ],
  "properties": {
    "v": {
      "anyOf": [
        {
          "type": "number",
          "const": 2
        },
        {
          "type": "number",
          "const": 1
        }
      ]
    },
    "seq": {
      "type": "number"
    },
    "event": {
      "type": "string",
      "const": "plugin.decision"
    },
    "timestamp": {
      "type": "string"
    },
    "execution_id": {
      "type": "string"
    },
    "stage_id": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "plugin",
        "invocation_id",
        "proposed",
        "results"
      ],
      "properties": {
        "plugin": {
          "type": "string"
        },
        "invocation_id": {
          "type": "string"
        },
        "proposed": {
          "type": "array",
          "items": {
            "type": "object",
            "patternProperties": {
              "^.*$": {}
            }
          }
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "status"
            ],
            "properties": {
              "kind": {
                "type": "string"
              },
              "status": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "applied"
                  },
                  {
                    "type": "string",
                    "const": "rejected"
                  }
                ]
              },
              "reason": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string"
              }
            }
          }
        },
        "agent_calls": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "index",
              "client",
              "model",
              "outcome"
            ],
            "properties": {
              "index": {
                "type": "number"
              },
              "client": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "model": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "duration_ms": {
                "type": "number"
              },
              "usage": {},
              "exit_code": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "classification": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "outcome": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "succeeded"
                  },
                  {
                    "type": "string",
                    "const": "failed"
                  },
                  {
                    "type": "string",
                    "const": "denied"
                  }
                ]
              },
              "output_path": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "title": "Event `plugin.decision`"
}
