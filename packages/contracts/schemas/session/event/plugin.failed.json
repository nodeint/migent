            "error",
            "timeout",
            "invalid_intent",
            "unavailable",
            "version_changed",
            "cancelled"
          ]
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "on_error": {
          "enum": [
            "ignore",
            "stop",
            "fail"
