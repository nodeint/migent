                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "classification": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "outcome": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "succeeded"
                  },
                  {
                    "type": "string",
                    "const": "failed"
                  },
                  {
                    "type": "string",
                    "const": "denied"
                  }
                ]
              },
              "output_path": {
                "anyOf": [
