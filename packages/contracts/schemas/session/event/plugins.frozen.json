{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nodeint/migent/main/packages/contracts/schemas/session/event/plugins.frozen.json",
  "type": "object",
  "required": [
    "event",
    "timestamp",
    "data"
  ],
  "properties": {
    "v": {
      "anyOf": [
        {
          "type": "number",
          "const": 2
        },
        {
          "type": "number",
          "const": 1
        }
      ]
    },
    "seq": {
      "type": "number"
    },
    "event": {
      "type": "string",
      "const": "plugins.frozen"
    },
    "timestamp": {
      "type": "string"
    },
    "execution_id": {
      "type": "string"
    },
    "stage_id": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "freeze_hash",
        "plugins"
      ],
      "properties": {
        "freeze_hash": {
          "type": "string"
        },
        "plugins": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "enabled",
              "advisory",
              "version",
              "target"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              },
              "advisory": {
                "type": "boolean"
              },
              "version": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "target": {
                "anyOf": [
                  {
                    "type": "object",
                    "patternProperties": {
                      "^.*$": {}
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "role_freeze": {
          "type": "object",
          "required": [
            "plugins",
            "target",
            "extensions"
          ],
          "properties": {
            "plugins": {
              "type": "object",
              "required": [
                "entries",
                "live_entries"
              ],
              "properties": {
                "entries": {
                  "type": "object",
                  "patternProperties": {
                    "^.*$": {}
                  }
                },
                "live_entries": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "target": {
              "type": "object",
              "required": [
                "client",
                "model"
              ],
              "properties": {
                "client": {
                  "type": "string"
                },
                "model": {
                  "type": "string"
                },
                "extensions": {
                  "type": "object",
                  "patternProperties": {
                    "^.*$": {}
                  }
                },
                "role_extensions": {
                  "type": "object",
                  "patternProperties": {
                    "^.*$": {}
                  }
                }
              }
            },
            "extensions": {
              "type": "object",
              "patternProperties": {
                "^.*$": {}
              }
            }
          },
          "description": "Plugin selection, resolved target and extension records frozen for a role session."
        }
      }
    }
  },
  "title": "Event `plugins.frozen`"
}
