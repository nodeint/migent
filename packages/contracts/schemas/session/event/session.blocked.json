{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nodeint/migent/main/packages/contracts/schemas/session/event/session.blocked.json",
  "type": "object",
  "required": [
    "event",
    "timestamp",
    "data"
  ],
  "properties": {
    "v": {
      "anyOf": [
        {
          "type": "number",
          "const": 2
        },
        {
          "type": "number",
          "const": 1
        }
      ]
    },
    "seq": {
      "type": "number"
    },
    "event": {
      "type": "string",
      "const": "session.blocked"
    },
    "timestamp": {
      "type": "string"
    },
    "execution_id": {
      "type": "string"
    },
    "stage_id": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "decision": {
      "type": "string"
    },
    "blocker": {
      "type": "string"
    },
    "question": {},
    "questions": {},
    "data": {
      "type": "object",
      "properties": {
        "from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string"
        },
        "manual": {
          "type": "boolean"
        },
        "reply": {
          "type": "string"
        },
        "origin": {
          "type": "string"
        },
        "answers": {
          "type": "array",
          "items": {
            "type": "object",
            "patternProperties": {
              "^.*$": {}
            }
          }
        },
        "outcome": {
          "anyOf": [
            {
              "type": "object",
              "patternProperties": {
                "^.*$": {}
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "title": "Event `session.blocked`"
}
