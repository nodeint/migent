{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nodeint/migent/main/packages/contracts/schemas/session/event/session.created.json",
  "type": "object",
  "required": [
    "event",
    "timestamp",
    "data"
  ],
  "properties": {
    "v": {
      "anyOf": [
        {
          "type": "number",
          "const": 2
        },
        {
          "type": "number",
          "const": 1
        }
      ]
    },
    "seq": {
      "type": "number"
    },
    "event": {
      "type": "string",
      "const": "session.created"
    },
    "timestamp": {
      "type": "string"
    },
    "execution_id": {
      "type": "string"
    },
    "stage_id": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "properties": {
        "workflow_id": {
          "type": "string"
        },
        "workflow_path": {
          "type": "string"
        },
        "hash": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "task": {
          "type": "string"
        },
        "prior_session_id": {
          "type": "string"
        },
        "handoff": {
          "type": "object",
          "patternProperties": {
            "^.*$": {}
          }
        },
        "role": {
          "type": "string"
        },
        "prepared": {
          "type": "boolean"
        }
      }
    }
  },
  "title": "Event `session.created`"
}
