{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nodeint/migent/main/packages/contracts/schemas/workflow/document.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^\\s*\\d+\\s*$"
        }
      ],
      "description": "Document version, an integer or a digit string."
    },
    "id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "\\S",
          "description": "A string with a non-blank value."
        },
        {
          "type": "null"
        }
      ]
    },
    "stages": {
      "type": "array",
      "items": {
        "$ref": "https://raw.githubusercontent.com/nodeint/migent/main/packages/contracts/schemas/workflow/stage.json"
      },
      "description": "The workflow's stages."
    },
    "artifacts": {
      "anyOf": [
        {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "$ref": "https://raw.githubusercontent.com/nodeint/migent/main/packages/contracts/schemas/workflow/artifact.json"
            }
          },
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "description": "Published artifacts by id."
        },
        {
          "type": "null"
        }
      ]
    },
    "concurrency": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "string",
              "pattern": "^\\s*0*[1-9]\\d*\\s*$"
            }
          ],
          "description": "A whole number of at least 1, written as an integer or a digit string."
        },
        {
          "type": "null"
        }
      ]
    },
    "constraints": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S",
            "description": "A string with a non-blank value."
          },
          "description": "Constraints included in every prompt."
        },
        {
          "type": "null"
        }
      ]
    },
    "downstream": {
      "type": "array",
      "items": {
        "$ref": "https://raw.githubusercontent.com/nodeint/migent/main/packages/contracts/schemas/workflow/downstream.json"
      },
      "description": "Workflows to suggest next."
    },
    "completion": {
      "type": "null",
      "description": "Not allowed from schema_version 2; kept so older files report a migration hint."
    }
  },
  "title": "Workflow file",
  "description": "An authored workflow file at schema_version 7.",
  "additionalProperties": false
}
