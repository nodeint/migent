  "description": "First-party plugins and their static registry for Migent.",
  "keywords": [
    "ai",
    "agents",
    "workflow",
    "cli",
    "plugins",
    "migent"
  ],
  "license": "MIT",
  "homepage": "https://github.com/nodeint/migent/tree/main/packages/plugins#readme",
  "bugs": {
    "url": "https://github.com/nodeint/migent/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodeint/migent.git",
    "directory": "packages/plugins"
  },
  "type": "module",
